import os
import datetime
from groq import Groq
from dotenv import load_dotenv

# Load environment variables from .env file
load_dotenv()

# --- CONFIGURATION ---
API_KEY = os.getenv("GROQ_API_KEY")
if not API_KEY:
    print("\033[91mERROR: GROQ_API_KEY not found!\033[0m")
    print("Please create a .env file with your API key.")
    print("You can copy .env.example and fill in your key.")
    exit(1)

MODEL = os.getenv("GROQ_MODEL", "llama-3.3-70b-versatile")  # llama-3.1-8b-instant daha kota yüksek
TASKS_DIR = "tasks"
LESSONS_FILE = os.path.join(TASKS_DIR, "lessons.md")

class SeniorAIEngineer:
    def __init__(self):
        self.client = Groq(api_key=API_KEY)
        self.history = []
        self._init_workspace()
        self._load_system_prompt()

    def _init_workspace(self):
        if not os.path.exists(TASKS_DIR):
            os.makedirs(TASKS_DIR)
        if not os.path.exists(LESSONS_FILE):
            with open(LESSONS_FILE, "w") as f: f.write("# Lessons Learned Log\n")

    def _load_system_prompt(self):
        lessons_context = ""
        try:
            with open(LESSONS_FILE, "r") as f:
                lines = f.readlines()
                last_lessons = "".join(lines[-5:])
                lessons_context = f"\nRecent lessons learned from your history:\n{last_lessons}"
        except:
            pass

        self.history = [{
            "role": "system",
            "content": (
                "You are a Staff Software Engineer. "
                "Context: User is Ozkan, a Computer Engineering student (UAV/ROS2 AI ML Python C++ C# focus).\n"
                f"{lessons_context}\n"
                "Rules:\n"
                "1. If a file is provided, analyze it line-by-line.\n"
                "2. Follow 'Plan Mode': Architecture first, code second.\n"
                "3. No Laziness: Find the root cause of bugs.\n"
                "4. Minimal Impact: Suggest clean, focused changes."
            )
        }]

    def log_lesson(self, lesson_text):
        timestamp = datetime.datetime.now().strftime("%Y-%m-%d %H:%M")
        with open(LESSONS_FILE, "a") as f:
            f.write(f"- [{timestamp}]: {lesson_text}\n")
        return f"Successfully logged to {LESSONS_FILE}"

    def read_file_content(self, file_path):
        """Read file with support for relative, absolute, and ~ paths"""
        try:
            # Expand ~ to home directory and convert to absolute path
            expanded_path = os.path.expanduser(file_path)
            absolute_path = os.path.abspath(expanded_path)
            
            # Check if file exists
            if not os.path.exists(absolute_path):
                return f"[FILE_READ_ERROR]\033[91mError: File not found: {file_path}\033[0m\n" \
                       f"Tried absolute path: {absolute_path}\n" \
                       f"Please check the file path and try again."
            
            # Check if it's a file (not a directory)
            if not os.path.isfile(absolute_path):
                return f"[FILE_READ_ERROR]\033[91mError: Path is not a file: {file_path}\033[0m"
            
            with open(absolute_path, "r", encoding="utf-8") as f:
                content = f.read()
            return f"\n--- FILE CONTENT ({absolute_path}) ---\n{content}\n--- END OF FILE ---"
        except PermissionError:
            return f"[FILE_READ_ERROR]\033[91mError: Permission denied to read file: {file_path}\033[0m"
        except UnicodeDecodeError:
            return f"[FILE_READ_ERROR]\033[91mError: File is not a text file or encoding issue: {file_path}\033[0m"
        except Exception as e:
            return f"[FILE_READ_ERROR]\033[91mError reading file: {str(e)}\033[0m"

    def get_response(self, user_input):
        file_was_read = False
        
        # 1. Dosya Okuma ve Hazırlık
        if "read:" in user_input.lower():
            # Find the position of "read:" (case-insensitive)
            read_pos = user_input.lower().find("read:")
            after_read = user_input[read_pos + 5:].strip()  # Get text after "read:"
            
            # Extract file path (first word/token)
            potential_file = after_read.split()[0].rstrip('.') if after_read else ""
            
            if not potential_file:
                return "[FILE_READ_ERROR]\033[91mError: No file path provided after 'read:' command\033[0m"
            
            file_data = self.read_file_content(potential_file)
            
            if not file_data.startswith("[FILE_READ_ERROR]"):
                file_msg = f"FILE CONTENT FOR ANALYSIS: {file_data}"
                self.history.append({"role": "user", "content": file_msg})
                file_was_read = True # Dosya okunduğunu işaretle
                
                # Extract user prompt (everything after the file path)
                # Remove the file path from after_read to get the actual prompt
                user_prompt = after_read[len(potential_file):].strip()
                if not user_prompt: 
                    user_prompt = "Analyze this file in detail."
                
                user_input = f"Reference: {potential_file}. {user_prompt}"
            else:
                # Remove the error marker before returning to user
                return file_data.replace("[FILE_READ_ERROR]", "")

        # 2. Sliding Window (Hafıza Temizliği)
        if len(self.history) > 20: 
            self.history = [self.history[0]] + self.history[-10:]

        self.history.append({"role": "user", "content": user_input})
        
        try:
            completion = self.client.chat.completions.create(
                model=MODEL,
                messages=self.history,
                temperature=0.2
            )
            response = completion.choices[0].message.content
            self.history.append({"role": "assistant", "content": response})

            # --- KOTA KORUMA (Token Saver) ---
            # Eğer dosya okunduysa, cevabı aldıktan sonra dosya içeriğini 
            # hafızadan siliyoruz ki bir sonraki soruda kota harcamasın.
            if file_was_read:
                # Son eklediğimiz kullanıcı mesajından bir önceki mesaj dosya içeriğidir.
                # Onu hafızadan çıkarıyoruz.
                self.history.pop(-3) 

            return response
            
        except Exception as e:
            if "length" in str(e).lower() or "rate_limit" in str(e).lower():
                self.history = [self.history[0]] 
                return "System limit reached. Memory cleared for safety. Please try again."
            return f"Execution Error: {str(e)}"

if __name__ == "__main__":
    engineer = SeniorAIEngineer()
    # --- PROFESSIONAL HEADER WITH HINTS ---
    print("\033[94m" + "="*50)
    print("ÖZKAN'S AGENT ACTIVE")
    print("="*50 + "\033[0m")
    print("\033[93m📊 Current Model:\033[0m", MODEL)
    print("\033[95mPRO-TIPS & COMMANDS:\033[0m")
    print("  • \033[96mread:\033[0m <file.py> [prompt]  -> Analyze local code")
    print("    \033[90m(Supports: relative paths, absolute paths, ~/home paths)\033[0m")
    print("  • \033[96mlesson:\033[0m <text>            -> Log patterns to lessons.md")
    print("  • \033[96mexit/quit\033[0m                   -> Terminate session")
    print("\033[94m" + "-"*50 + "\033[0m")
    
    # Display recent memory
    print("\033[93m[Memory Check] Recent Lessons Applied:\033[0m")
    try:
        with open(LESSONS_FILE, "r") as f:
            print("".join(f.readlines()[-3:]))
    except:
        print("No lessons found yet.")

    while True:
        user_msg = input("\n\033[92m[User]:\033[0m ")
        if user_msg.lower() in ["exit", "quit"]: break
        
        if user_msg.lower().startswith("lesson:"):
            text = user_msg.split("lesson:")[1].strip()
            print(f"\033[93m>> {engineer.log_lesson(text)}\033[0m")
            continue

        response = engineer.get_response(user_msg)
        print(f"\n\033[96m[Agent]:\033[0m\n{response}")
